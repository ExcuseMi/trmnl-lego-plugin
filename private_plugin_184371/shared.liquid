<style>

  .lego-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }
  
  .infopanel {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 100;
  }
  
  .qr-code {
    position: absolute;
    top: 8px;
    z-index: 100;
    background-color: white;
    padding: 5px;
    border: solid 1px black;
    box-sizing: content-box;
    border-radius: 8px;
    {% if show_infopanel %}left: 8px;{% else %}right: 8px;{% endif %}
  }
</style>
{% assign info_value_cls = "label sm:label--small md:sm:label--small lg:label--large  bg--white rounded m--1 pl--1 pr--1" %}
{% if error %}
<div class="layout layout--stretch layout--center">
  <div class="title">{{ error }}</div>
  {% if min_year or max_year or min_parts or max_parts %}
  <div class="description">
    No LEGO sets found with your current settings.<br/><br/>
    Active filters:<br/>
    {% if min_year %}Min year: {{ min_year }}<br/>{% endif %}
    {% if max_year %}Max year: {{ max_year }}<br/>{% endif %}
    {% if min_parts %}Min parts: {{ min_parts }}<br/>{% endif %}
    {% if max_parts %}Max parts: {{ max_parts }}<br/>{% endif %}
    <br/>
    Adjust your filters to see more sets.
  </div>
  {% endif %}
</div>

{% else %}
<div class="layout layout--stretch">
  <div class="lego-container">
    <img src="{{image}}" class="image image-dither main-image" />
    
    {% if show_infopanel %}
    <div class="infopanel">
      <div class="rounded bg--gray-75 gap--none"> 
        <div class="flex flex--column gap--none"> 
          {% if num_parts > 0 %} 
          <div class="flex flex--row flex--align-center gap--none">
            <img class="image w--6 lg:w--10 image-dither image--stroke" src="https://raw.githubusercontent.com/ExcuseMi/trmnl-lego-plugin/refs/heads/main/images/brick.png" /> 
            <div class="{{ info_value_cls }}">{{num_parts}}</div>
          </div>
          {% endif %} 
          
          {% if brickset_show_minifigs_included == "yes" and minifigs > 0 %} 
          <div class="flex flex--row flex--align-center gap--none">
            <img class="image w--6 lg:w--10 image-dither image--stroke" src="https://raw.githubusercontent.com/ExcuseMi/trmnl-lego-plugin/refs/heads/main/images/minifig.png" /> 
            <div class="{{info_value_cls}}">{{minifigs}}</div> 
          </div>
          {% endif %} 
          
          {% if brickset_show_owned_wanted_indicators == "yes" %}
            {% if owned == "1" %} 
            <div class="flex flex--row flex--align-center gap--none">
              <img class="image w--6 lg:w--10 image-dither image--stroke" src="https://raw.githubusercontent.com/ExcuseMi/trmnl-lego-plugin/refs/heads/main/images/own.png" /> 
            </div>
            {% elsif wanted == "1" %} 
            <div class="flex flex--row flex--align-center gap--xs">
              <img class="image w--6 lg:w--10 image-dither image--stroke" src="https://raw.githubusercontent.com/ExcuseMi/trmnl-lego-plugin/refs/heads/main/images/want.png" /> 
            </div>
            {% endif %}
          {% endif %}
          
          {% if price != "" and price != blank and price != nil %} 
          <div class="flex flex--row flex--align-center gap--none ">
            <img class="image w--6 lg:w--10 image-dither image--stroke" src="https://raw.githubusercontent.com/ExcuseMi/trmnl-lego-plugin/refs/heads/main/images/price.png" /> 
            <div class="{{ info_value_cls }}">{{price}}</div>
          </div>
          {% endif %} 
        </div>
      </div>
    </div>
    {% endif %}
    
    {% if show_qr_code and show_qr_code != "hide" %}
    <div class="qr-code">
      {% if vendor == "rebrickable" %}
      {{ rebrickable_url | qr_code: 3, 'm' }}
      {% elsif vendor == "brickset" %}
      {{ brickset_url | qr_code: 3, 'm' }}
      {% endif %}
    </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  {% if set_num != ""%}<span class="label label--inverted">{{set_num}}</span>{% endif %}
  <span class="title text--stroke">{{name}}{% if year and year > 0 %} ({{year}}){% endif %}</span>
  <span class="instance text--stroke" data-content-limiter="true">{{theme}}</span>
</div>
{% endif %}